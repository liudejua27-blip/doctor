{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://body-companion.invalid/contracts/body-surface-correspondence.schema.json",
  "title": "BodyRenderCollisionSurfaceCorrespondence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "asset_version",
    "topology_id",
    "render_artifact_id",
    "collision_artifact_id",
    "collision_mesh_id",
    "entries",
    "generated_at",
    "mapping_kind",
    "mapping_version"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"},
    "asset_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "topology_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "render_artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "collision_artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "collision_mesh_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "generated_at": {"type": "string", "format": "date-time"},
    "mapping_kind": {"type": "string", "const": "render_mesh_to_collision_face_ranges"},
    "mapping_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "boundary_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "laterality", "surface", "confidence"],
      "properties": {
        "region_id": {"type": "string", "pattern": "^body\\.[a-z0-9_]+\\.general$"},
        "laterality": {"type": "string", "enum": ["midline", "left", "right", "bilateral", "unspecified"]},
        "surface": {"type": "string", "enum": ["anterior", "posterior", "medial", "lateral", "superior", "inferior", "circumferential", "unspecified"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "render_mesh_id",
        "collision_mesh_id",
        "render_triangle_range",
        "render_triangle_count",
        "render_vertex_count",
        "collision_face_ranges",
        "method",
        "confidence",
        "quality_status",
        "boundary_candidates"
      ],
      "properties": {
        "entry_id": {"type": "string", "pattern": "^[0-9]{3,8}$"},
        "render_mesh_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
        "collision_mesh_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$"},
        "render_triangle_range": {"$ref": "#/$defs/range"},
        "render_triangle_count": {"type": "integer", "minimum": 1},
        "render_vertex_count": {"type": "integer", "minimum": 1},
        "collision_face_ranges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/range"}},
        "method": {"type": "string", "enum": ["semantic_mesh_to_static_proxy", "surface_projection", "manual_reviewed"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "quality_status": {"type": "string", "enum": ["candidate_proxy_unmeasured", "measured", "reviewed"]},
        "boundary_candidates": {"type": "array", "items": {"$ref": "#/$defs/boundary_candidate"}}
      }
    }
  }
}
