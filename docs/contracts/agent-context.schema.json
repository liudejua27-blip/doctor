{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.bodycompanion.example/schemas/v1/agent-context.schema.json",
  "title": "AgentReadContext",
  "description": "服务端构造的、主体绑定的最小授权上下文；不得包含原始健康对话、访问令牌或通用查询能力。",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_id", "authenticated_user_id", "purpose", "grants", "redaction_policy_version"],
  "properties": {
    "context_id": {"type": "string", "format": "uuid"},
    "authenticated_user_id": {"type": "string", "format": "uuid"},
    "purpose": {"type": "string", "enum": ["assessment", "trend_review", "report_draft"]},
    "grants": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/ConsentGrant"}},
    "profile": {"$ref": "#/$defs/ProfileContext"},
    "episode": {"$ref": "#/$defs/EpisodeContext"},
    "guidance": {"$ref": "#/$defs/GuidanceContext"},
    "redaction_policy_version": {"type": "string", "minLength": 1, "maxLength": 40}
  },
  "$defs": {
    "Scope": {"type": "string", "enum": ["body_profile_read", "current_episode_read", "historical_events_read", "verified_content_read"]},
    "ConsentGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_user_id", "scope", "consent_receipt_id", "purpose", "granted_at"],
      "properties": {
        "subject_user_id": {"type": "string", "format": "uuid"},
        "scope": {"$ref": "#/$defs/Scope"},
        "consent_receipt_id": {"type": "string", "format": "uuid"},
        "purpose": {"type": "string", "enum": ["assessment", "trend_review", "report_draft"]},
        "granted_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "revoked_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "revision", "field_keys"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "maxLength": 240},
        "source_type": {"type": "string", "enum": ["body_profile", "confirmed_event", "verified_content"]},
        "revision": {"type": "integer", "minimum": 1},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "field_keys": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}
      }
    },
    "ProfileContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_user_id", "profile_revision", "activity_types", "work_pattern", "sources"],
      "properties": {
        "owner_user_id": {"type": "string", "format": "uuid"},
        "profile_revision": {"type": "integer", "minimum": 1},
        "activity_types": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
        "training_frequency_per_week": {"type": ["integer", "null"], "minimum": 0, "maximum": 21},
        "work_pattern": {"type": "string", "enum": ["desk", "mixed", "physical", "unknown"]},
        "preferred_language": {"type": ["string", "null"], "minLength": 2, "maxLength": 20},
        "timezone": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "sources": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/SourceRef"}}
      }
    },
    "EventSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "episode_id", "owner_user_id", "resource_revision", "region_ids", "sensation_codes", "trend", "source"],
      "properties": {
        "event_id": {"type": "string", "format": "uuid"},
        "episode_id": {"type": "string", "format": "uuid"},
        "owner_user_id": {"type": "string", "format": "uuid"},
        "resource_revision": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": ["string", "null"], "format": "date-time"},
        "region_ids": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "sensation_codes": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "trend": {"type": "string", "enum": ["improving", "stable", "worsening", "fluctuating", "unknown"]},
        "functional_impact_codes": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "source": {"$ref": "#/$defs/SourceRef"}
      }
    },
    "EpisodeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_user_id", "episode_id", "episode_revision", "status", "scope", "events", "source"],
      "properties": {
        "owner_user_id": {"type": "string", "format": "uuid"},
        "episode_id": {"type": "string", "format": "uuid"},
        "episode_revision": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["open", "monitoring", "resolved", "closed"]},
        "scope": {"type": "string", "enum": ["current_episode_read", "historical_events_read"]},
        "events": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/EventSummary"}},
        "source": {"$ref": "#/$defs/SourceRef"}
      }
    },
    "GuidanceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "content_release_id", "locale", "purpose", "source"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "content_release_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "locale": {"type": "string", "minLength": 2, "maxLength": 20},
        "purpose": {"type": "string", "enum": ["assessment", "trend_review", "report_draft"]},
        "rendered_text": {"type": ["string", "null"], "maxLength": 2000},
        "source": {"$ref": "#/$defs/SourceRef"}
      }
    }
  }
}
