{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.bodycompanion.example/schemas/v1/ios-draft-envelope.schema.json",
  "title": "IOSUnconfirmedDraftEnvelope",
  "description": "iOS 本地或远端未确认的身体信号草稿。它不能表示正式 BodySignalEvent、Approval 或报告。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_id",
    "owner_id",
    "client_operation_id",
    "draft_revision",
    "lifecycle",
    "locations",
    "facts",
    "sync",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "draft_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner_id": {
      "type": "string",
      "format": "uuid",
      "description": "用于本地账户隔离；正式服务端仍必须从认证主体赋值。"
    },
    "client_operation_id": {
      "type": "string",
      "format": "uuid",
      "description": "一次可重试草稿同步意图的一对一幂等键。"
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 1
    },
    "lifecycle": {
      "type": "string",
      "enum": ["editing", "queued", "syncing", "conflict", "remote_unconfirmed", "discarded", "expired"]
    },
    "locations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "body-location.schema.json"
      }
    },
    "facts": {
      "$ref": "#/$defs/UnconfirmedFacts"
    },
    "sync": {
      "$ref": "#/$defs/DraftSyncState"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "UnconfirmedFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensation_codes",
        "time_pattern",
        "aggravating_factors",
        "relieving_factors",
        "functional_impacts",
        "background_facts"
      ],
      "properties": {
        "sensation_codes": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "time_pattern": {
          "type": "string",
          "maxLength": 128
        },
        "aggravating_factors": {
          "type": "array",
          "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "relieving_factors": {
          "type": "array",
          "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "functional_impacts": {
          "type": "array",
          "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "background_facts": {
          "type": "array",
          "maxItems": 50,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "raw_user_text": {
          "type": "string",
          "maxLength": 4000,
          "description": "用户主动输入的未确认原话；只允许在受保护草稿中存在，不得进入普通日志。"
        }
      }
    },
    "DraftSyncState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "attempt_count"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["not_queued", "queued", "in_flight", "accepted_unconfirmed", "conflict", "failed", "blocked"]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "last_error_code": {
          "type": "string",
          "maxLength": 80
        },
        "remote_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
