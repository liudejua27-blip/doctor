          "then": {
            "required": ["agent_version", "prompt_version", "provider", "model_name", "model_version"],
            "not": {"required": ["not_used_reason"]}
          }
        },
        {
          "if": {"properties": {"used": {"const": false}}, "required": ["used"]},
          "then": {
            "required": ["not_used_reason"],
            "not": {"anyOf": [
              {"required": ["agent_version"]},
              {"required": ["prompt_version"]},
              {"required": ["provider"]},
              {"required": ["model_name"]},
              {"required": ["model_version"]}
            ]}
          }
        }
      ]
    },
    "Confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
