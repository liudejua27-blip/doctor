{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.bodycompanion.example/schemas/v1/body-signal-event.schema.json",
  "title": "BodySignalEvent",
  "description": "用户某一时点或时段的身体信号快照。正式事件必须经服务端校验和用户确认；AI 解释不是诊断。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "user_id",
    "lifecycle",
    "resource_revision",
    "correction_sequence",
    "raw_input",
    "locations",
    "sensations",
    "temporal",
    "trend",
    "aggravating_factors",
    "relieving_factors",
    "functional_impacts",
    "background_facts",
    "safety_assessment",
    "action_plan",
    "provenance",
    "occurred_at",
    "recorded_at",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "服务端从认证主体赋值；不得信任客户端提供的所有者。"
    },
    "episode_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_turn_id": {
      "type": "string",
      "format": "uuid"
    },
    "lifecycle": {
      "type": "string",
      "enum": ["draft", "discarded", "confirmed", "superseded", "voided"]
    },
    "resource_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "单个 Event 资源的乐观并发/ETag 版本；生命周期元数据变化时递增。"
    },
    "correction_sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "同一 Episode 修订链中的序号；首个正式 Event 为 1，替代节点为直接前驱 + 1。"
    },
    "supersedes_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "superseded_by_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "raw_input": {
      "$ref": "#/$defs/RawInput"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "body-location.schema.json"
      }
    },
    "sensations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/Sensation"
      }
    },
    "temporal": {
      "$ref": "#/$defs/TemporalPattern"
    },
    "trend": {
      "type": "string",
      "enum": ["improving", "stable", "worsening", "fluctuating", "unknown"]
    },
    "aggravating_factors": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/AggravatingFactor"
      }
    },
    "relieving_factors": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/RelievingFactor"
      }
    },
    "functional_impacts": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/FunctionalImpact"
      }
    },
    "background_facts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/BackgroundFact"
      }
    },
    "safety_assessment": {
      "$ref": "#/$defs/SafetyAssessment"
    },
    "ai_interpretation": {
      "$ref": "#/$defs/AIInterpretation"
    },
    "action_plan": {
      "$ref": "#/$defs/ActionPlan"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "confirmation": {
      "$ref": "#/$defs/Confirmation"
    },
    "occurred_at": {
      "$ref": "#/$defs/ApproximateDateTime"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "examples": ["Asia/Shanghai"]
    },
    "content_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"processing_mode": {"enum": ["manual", "unsupported", "emergency", "urgent", "degraded"]}},
            "required": ["processing_mode"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {"not": {"required": ["ai_interpretation"]}}
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"processing_mode": {"enum": ["manual", "unsupported"]}},
            "required": ["processing_mode"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "action_plan": {
            "type": "object",
            "not": {"required": ["check_in_at"]},
            "properties": {
              "items": {
                "type": "array",
                "items": {"not": {"type": "object", "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}}, "required": ["category"]}}
              },
              "escalation_conditions": {
                "type": "array",
                "items": {"not": {"type": "object", "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}}, "required": ["category"]}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"processing_mode": {"const": "degraded"}},
            "required": ["processing_mode"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {"lifecycle": {"enum": ["draft", "discarded"]}},
        "not": {"anyOf": [
          {"required": ["confirmation"]},
          {"required": ["content_digest"]},
          {"required": ["ai_interpretation"]}
        ]}
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"processing_mode": {"const": "normal"}},
            "required": ["processing_mode"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {"ai_runtime": {"type": "object", "properties": {"used": {"const": true}}, "required": ["used"]}},
            "required": ["ai_runtime"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"processing_mode": {"enum": ["manual", "unsupported", "emergency", "urgent", "degraded"]}},
            "required": ["processing_mode"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {"ai_runtime": {"type": "object", "properties": {"used": {"const": false}}, "required": ["used"]}},
            "required": ["ai_runtime"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {"enum": ["confirmed", "superseded", "voided"]}
        },
        "required": ["lifecycle"]
      },
      "then": {
        "required": ["episode_id", "confirmation", "content_digest"],
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mapping": {
                  "type": "object",
                  "properties": {"reviewed_by_user": {"const": true}},
                  "required": ["reviewed_by_user"]
                }
              },
              "required": ["mapping"]
            }
          },
          "background_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"status": {"const": "user_confirmed"}},
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"lifecycle": {"enum": ["draft", "discarded"]}},
        "required": ["lifecycle"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["confirmation"]},
            {"required": ["content_digest"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"tier": {"enum": ["R0", "R1", "undetermined"]}},
            "required": ["tier"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "not": {"required": ["ai_interpretation"]},
        "properties": {
          "action_plan": {
            "type": "object",
            "not": {"required": ["check_in_at"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"status": {"enum": ["incomplete", "unavailable"]}},
            "required": ["status"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "not": {"required": ["ai_interpretation"]},
        "properties": {
          "action_plan": {
            "type": "object",
            "not": {"required": ["check_in_at"]},
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              },
              "escalation_conditions": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["supersedes_event_id"]
      },
      "then": {
        "required": ["episode_id"],
        "properties": {
          "lifecycle": {"enum": ["confirmed", "superseded", "voided"]},
          "correction_sequence": {"type": "integer", "minimum": 2}
        }
      }
    },
    {
      "if": {
        "properties": {"lifecycle": {"enum": ["confirmed", "superseded", "voided"]}},
        "required": ["lifecycle"],
        "not": {"required": ["supersedes_event_id"]}
      },
      "then": {
        "properties": {"correction_sequence": {"const": 1}}
      }
    },
    {
      "if": {
        "required": ["superseded_by_event_id"]
      },
      "then": {
        "required": ["episode_id"],
        "properties": {
          "lifecycle": {"const": "superseded"}
        }
      }
    },
    {
      "if": {
        "properties": {"lifecycle": {"const": "superseded"}},
        "required": ["lifecycle"]
      },
      "then": {
        "required": ["superseded_by_event_id"]
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"tier": {"const": "R0"}},
            "required": ["tier"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "action_plan": {
            "type": "object",
            "properties": {
              "tier": {"const": "R0"},
              "items": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"category": {"const": "urgent_help"}},
                  "required": ["category"]
                },
                "minContains": 1,
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              },
              "escalation_conditions": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              }
            },
            "required": ["tier", "items"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"tier": {"const": "R1"}},
            "required": ["tier"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "action_plan": {
            "type": "object",
            "properties": {
              "tier": {"const": "R1"},
              "items": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"category": {"const": "professional_review"}},
                  "required": ["category"]
                },
                "minContains": 1,
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              },
              "escalation_conditions": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              }
            },
            "required": ["tier", "items"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"tier": {"const": "R2"}},
            "required": ["tier"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "action_plan": {
            "type": "object",
            "properties": {
              "tier": {"const": "R2"},
              "items": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"category": {"const": "professional_review"}},
                  "required": ["category"]
                },
                "minContains": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"tier": {"const": "R3"}},
            "required": ["tier"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {"properties": {"action_plan": {"type": "object", "properties": {"tier": {"const": "R3"}}}}}
    },
    {
      "if": {
        "properties": {
          "safety_assessment": {
            "type": "object",
            "properties": {"tier": {"const": "undetermined"}},
            "required": ["tier"]
          }
        },
        "required": ["safety_assessment"]
      },
      "then": {
        "properties": {
          "action_plan": {
            "type": "object",
            "properties": {
              "tier": {"const": "undetermined"},
              "items": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              },
              "escalation_conditions": {
                "type": "array",
                "items": {
                  "not": {
                    "type": "object",
                    "properties": {"category": {"enum": ["observation", "load_adjustment", "check_in"]}},
                    "required": ["category"]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "RawInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "language", "captured_at"],
      "properties": {
        "modality": {
          "type": "string",
          "enum": ["text", "voice_transcript", "body_map", "mixed"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
          "examples": ["zh-CN"]
        },
        "source_ref": {
          "type": "string",
          "maxLength": 240,
          "description": "受控临时资源引用；不得是任意外部 URL。"
        },
        "transcript_confirmed_by_user": {
          "type": "boolean"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"modality": {"const": "text"}}, "required": ["modality"]},
          "then": {
            "required": ["text"],
            "not": {"required": ["transcript_confirmed_by_user"]}
          }
        },
        {
          "if": {"properties": {"modality": {"const": "voice_transcript"}}, "required": ["modality"]},
          "then": {
            "required": ["text", "transcript_confirmed_by_user"],
            "properties": {"transcript_confirmed_by_user": {"const": true}}
          }
        },
        {
          "if": {"properties": {"modality": {"const": "body_map"}}, "required": ["modality"]},
          "then": {
            "not": {"anyOf": [
              {"required": ["text"]},
              {"required": ["source_ref"]},
              {"required": ["transcript_confirmed_by_user"]}
            ]}
          }
        },
        {
          "if": {"properties": {"modality": {"const": "mixed"}}, "required": ["modality"]},
          "then": {"required": ["text"]}
        }
      ]
    },
    "Intensity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "value", "scale_min", "scale_max"],
      "properties": {
        "context": {
          "type": "string",
          "enum": ["current", "peak", "rest", "during_activity", "after_activity"]
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "scale_min": {
          "type": "integer",
          "const": 0
        },
        "scale_max": {
          "type": "integer",
          "const": 10
        },
        "window": {
          "$ref": "#/$defs/MeasurementWindow",
          "description": "context=peak 时必填，用于证明峰值属于哪个时间窗。"
        },
        "source": {
          "$ref": "#/$defs/SourceRef",
          "description": "事实来源；可选是为了兼容历史 AgentDraft，正式事件仍必须保留来源。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"context": {"const": "peak"}},
            "required": ["context"]
          },
          "then": {"required": ["window"]}
        }
      ]
    },
    "MeasurementWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"$ref": "#/$defs/ApproximateDateTime"},
        "end": {"$ref": "#/$defs/ApproximateDateTime"},
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 525600
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "支持“过去 24 小时”“这次跑步期间”等用户可理解的模糊时间窗。"
        }
      },
      "anyOf": [
        {"required": ["start", "end"]},
        {"required": ["duration_minutes"]},
        {"required": ["label"]}
      ]
    },
    "Sensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sensation_id", "code", "intensities", "location_marker_ids", "source"],
      "properties": {
        "sensation_id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string",
          "enum": [
            "aching",
            "dull_pain",
            "sharp_pain",
            "stabbing",
            "throbbing",
            "tenderness",
            "pressure",
            "burning",
            "electric",
            "radiating",
            "tingling",
            "numbness",
            "reduced_sensation",
            "tightness",
            "stiffness",
            "cramping",
            "catching",
            "clicking",
            "weakness",
            "instability",
            "giving_way",
            "movement_fear",
            "swelling",
            "redness",
            "warmth",
            "bruising",
            "itching",
            "fatigue",
            "heaviness",
            "post_activity_soreness",
            "other",
            "unknown"
          ]
        },
        "user_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "intensities": {
          "type": "array",
          "maxItems": 5,
          "items": {"$ref": "#/$defs/Intensity"}
        },
        "location_marker_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"code": {"const": "other"}}, "required": ["code"]},
          "then": {"required": ["user_label"]}
        }
      ]
    },
    "ApproximateDateTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision"],
      "properties": {
        "value": {
          "type": "string",
          "format": "date-time"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "precision": {
          "type": "string",
          "enum": ["exact", "hour", "day", "week", "month", "approximate", "unknown"]
        },
        "user_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "not": {"required": ["value", "date"]}
        },
        {
          "if": {
            "properties": {"precision": {"enum": ["exact", "hour"]}},
            "required": ["precision"]
          },
          "then": {
            "required": ["value"],
            "not": {"required": ["date"]}
          }
        },
        {
          "if": {
            "properties": {"precision": {"enum": ["day", "week", "month"]}},
            "required": ["precision"]
          },
          "then": {
            "required": ["date"],
            "not": {"required": ["value"]}
          }
        },
        {
          "if": {
            "properties": {"precision": {"enum": ["approximate", "unknown"]}},
            "required": ["precision"]
          },
          "then": {
            "required": ["user_text"]
          }
        },
        {
          "if": {
            "properties": {"precision": {"const": "unknown"}},
            "required": ["precision"]
          },
          "then": {
            "not": {
              "anyOf": [
                {"required": ["value"]},
                {"required": ["date"]}
              ]
            }
          }
        }
      ]
    },
    "TemporalPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onset_mode", "course", "frequency"],
      "properties": {
        "onset": {
          "$ref": "#/$defs/ApproximateDateTime"
        },
        "onset_mode": {
          "type": "string",
          "enum": ["sudden", "gradual", "after_specific_event", "unknown"]
        },
        "course": {
          "type": "string",
