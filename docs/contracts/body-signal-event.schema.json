    "SafetyAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "answer_type", "answer_state", "answered_at", "source"],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,120}$"
        },
        "answer_type": {
          "type": "string",
          "enum": ["boolean", "single_choice", "multiple_choice"]
        },
        "answer_state": {
          "type": "string",
          "enum": ["answered", "uncertain", "not_answered"]
        },
        "boolean_value": {
          "type": "boolean"
        },
        "choice_values": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "user_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/SourceRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"answer_state": {"const": "answered"}, "answer_type": {"const": "boolean"}},
            "required": ["answer_state", "answer_type"]
          },
          "then": {
            "required": ["boolean_value"],
            "not": {"required": ["choice_values"]}
          }
        },
        {
          "if": {
            "properties": {"answer_state": {"const": "answered"}, "answer_type": {"const": "single_choice"}},
            "required": ["answer_state", "answer_type"]
          },
          "then": {
            "required": ["choice_values"],
            "properties": {"choice_values": {"type": "array", "minItems": 1, "maxItems": 1}},
            "not": {"required": ["boolean_value"]}
          }
        },
        {
          "if": {
            "properties": {"answer_state": {"const": "answered"}, "answer_type": {"const": "multiple_choice"}},
            "required": ["answer_state", "answer_type"]
          },
          "then": {
            "required": ["choice_values"],
            "properties": {"choice_values": {"type": "array", "minItems": 1}},
            "not": {"required": ["boolean_value"]}
          }
        },
        {
          "if": {
            "properties": {"answer_state": {"enum": ["uncertain", "not_answered"]}},
            "required": ["answer_state"]
          },
          "then": {
            "not": {"anyOf": [
              {"required": ["boolean_value"]},
              {"required": ["choice_values"]}
            ]}
          }
        }
      ]
    },
    "RuleHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "result", "tier", "evidence_refs"],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,120}$"
        },
        "result": {
          "type": "string",
          "enum": ["matched", "not_matched", "undetermined"]
        },
        "tier": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "R3", "undetermined"]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"result": {"const": "matched"}},
            "required": ["result"]
          },
          "then": {
            "properties": {
              "tier": {"enum": ["R0", "R1", "R2", "R3"]},
              "evidence_refs": {"type": "array", "minItems": 1}
            }
          }
        }
      ]
    },
    "SafetyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "tier",
        "rule_outcome",
        "all_current_rules_executed",
        "triggered_rule_ids",
        "rule_set_version",
        "answers",
        "rule_hits",
        "required_action_code",
        "processing_mode",
        "evaluated_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "incomplete", "unavailable"]
        },
        "tier": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "R3", "undetermined"]
        },
        "rule_outcome": {
          "type": "string",
          "enum": ["triggered", "no_rule_triggered", "unresolved", "unavailable"]
        },
        "all_current_rules_executed": {"type": "boolean"},
        "triggered_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"}
        },
        "rule_set_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "answers": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/SafetyAnswer"}
        },
        "rule_hits": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/RuleHit"}
        },
        "required_action_code": {
          "type": "string",
          "pattern": "^[A-Z0-9._-]{1,120}$"
        },
        "processing_mode": {
          "type": "string",
          "enum": ["emergency", "urgent", "normal", "manual", "unsupported", "degraded"],
          "description": "本次事件实际采用的输出/记录路径；manual 与 unsupported 可确认事实但不使用 AI 解释，degraded 不得形成正式事件。"
        },
        "model_suggested_escalation": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "none"],
          "description": "只保存模型提出的候选上调线索。候选必须先由用户确认并重新运行确定性规则；模型值不能直接改变最终 tier，也绝不允许降级。"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
          "then": {"properties": {"all_current_rules_executed": {"const": true}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["incomplete", "unavailable"]}}, "required": ["status"]},
          "then": {"properties": {"all_current_rules_executed": {"const": false}}}
        },
        {
          "if": {"properties": {"rule_outcome": {"const": "no_rule_triggered"}}, "required": ["rule_outcome"]},
          "then": {
            "properties": {
              "status": {"const": "complete"},
              "tier": {"const": "R3"},
              "all_current_rules_executed": {"const": true},
              "triggered_rule_ids": {"type": "array", "maxItems": 0},
              "rule_hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {"result": {"const": "not_matched"}},
                  "required": ["result"]
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"rule_outcome": {"const": "triggered"}}, "required": ["rule_outcome"]},
          "then": {
            "properties": {
              "triggered_rule_ids": {"type": "array", "minItems": 1},
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "matched"}},
                  "required": ["result"]
                },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"rule_outcome": {"const": "unresolved"}}, "required": ["rule_outcome"]},
          "then": {
            "properties": {
              "status": {"const": "incomplete"},
              "tier": {"const": "undetermined"},
              "all_current_rules_executed": {"const": false},
              "triggered_rule_ids": {"type": "array", "maxItems": 0},
              "rule_hits": {
                "type": "array",
                "not": {
                  "contains": {
                    "type": "object",
                    "properties": {"result": {"const": "matched"}},
                    "required": ["result"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"rule_outcome": {"const": "unavailable"}}, "required": ["rule_outcome"]},
          "then": {
            "properties": {
              "status": {"const": "unavailable"},
              "tier": {"const": "undetermined"},
              "all_current_rules_executed": {"const": false},
              "triggered_rule_ids": {"type": "array", "maxItems": 0},
              "rule_hits": {"type": "array", "maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"tier": {"const": "R0"}}, "required": ["tier"]},
          "then": {"properties": {"processing_mode": {"const": "emergency"}}}
        },
        {
          "if": {"properties": {"tier": {"const": "R1"}}, "required": ["tier"]},
          "then": {"properties": {"processing_mode": {"const": "urgent"}}}
        },
        {
          "if": {"properties": {"tier": {"const": "undetermined"}}, "required": ["tier"]},
          "then": {"properties": {"processing_mode": {"const": "degraded"}}}
        },
        {
          "if": {"properties": {"processing_mode": {"enum": ["normal", "manual", "unsupported"]}}, "required": ["processing_mode"]},
          "then": {
            "properties": {
              "status": {"const": "complete"},
              "tier": {"enum": ["R2", "R3"]},
              "all_current_rules_executed": {"const": true}
            }
          }
        },
        {
          "if": {
            "properties": {
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "undetermined"}},
                  "required": ["result"]
                }
              }
            },
            "required": ["rule_hits"]
          },
          "then": {
            "properties": {
              "status": {"const": "incomplete"},
              "all_current_rules_executed": {"const": false},
              "rule_outcome": {"enum": ["triggered", "unresolved"]}
            }
          }
        },
        {
          "if": {
            "properties": {
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "matched"}},
                  "required": ["result"]
                }
              }
            },
            "required": ["rule_hits"]
          },
          "then": {"properties": {"rule_outcome": {"const": "triggered"}}}
        },
        {
          "if": {
            "properties": {
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "matched"}, "tier": {"const": "R0"}},
                  "required": ["result", "tier"]
                }
              }
            },
            "required": ["rule_hits"]
          },
          "then": {"properties": {"tier": {"const": "R0"}}}
        },
        {
          "if": {
            "properties": {
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "matched"}, "tier": {"const": "R1"}},
                  "required": ["result", "tier"]
                }
              }
            },
            "required": ["rule_hits"]
          },
          "then": {"properties": {"tier": {"enum": ["R0", "R1"]}}}
        },
        {
          "if": {
            "properties": {
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "matched"}, "tier": {"const": "R2"}},
                  "required": ["result", "tier"]
                }
              }
            },
            "required": ["rule_hits"]
          },
          "then": {"properties": {"tier": {"enum": ["R0", "R1", "R2"]}}}
        },
        {
          "if": {
            "properties": {
              "rule_hits": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {"result": {"const": "matched"}, "tier": {"const": "R3"}},
                  "required": ["result", "tier"]
                }
              }
            },
            "required": ["rule_hits"]
          },
          "then": {"properties": {"tier": {"enum": ["R0", "R1", "R2", "R3"]}}}
        }
      ]
    },
